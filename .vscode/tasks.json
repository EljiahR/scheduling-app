{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SchedulingServer/SchedulingServer.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/SchedulingServer/SchedulingServer.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/SchedulingServer/SchedulingServer.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Start Web Client",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/web"
            }
        },
        {
            "label": "Start Server",
            "type": "shell",
            "command": "dotnet run",
            "options": {
                "cwd": "${workspaceFolder}/SchedulingServer"
            }
        },
        {
            "label": "Start All",
            "dependsOn": ["Start Web Client", "Start Server"],
            "dependsOrder": "parallel"
        },
        {
            "label": "Kill Ports",
            "type": "shell",
            "command": "/bin/bash",
            "args": ["${workspaceFolder}/scripts/port_cleanup.sh"],
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "RM Test DB",
            "type": "shell",
            "command": "/bin/bash",
            "args": ["${workspaceFolder}/scripts/db_cleanup.sh"],
            "presentation": {
                "echo": false,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Clean Project",
            "dependsOn": ["Kill Ports", "RM Test DB"],
            "dependsOrder": "sequence"
        },
    ]
}